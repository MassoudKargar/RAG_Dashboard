# RAG Dashboard — example configuration (placeholders only).
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.

# --- Server ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=4173

# --- Sessions / admin auth ---
# Change this to a long random string before any public deployment.
SESSION_SECRET=replace-with-a-random-secret
SESSION_TTL_MINUTES=480
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=10

# --- RAG internal API (this dashboard talks to your local RAG service) ---
RAG_API_URL=http://127.0.0.1:8000
RAG_API_AUTH_MODE=bearer
RAG_API_KEY=replace-me

# --- Embedding / RAG service internals (reference only, read by the RAG service) ---
EMBEDDING_API_URL=http://127.0.0.1:9010/embed
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Benchmark data mode ---
# files     = read benchmark run artifacts from RAG_BENCHMARK_RESULTS_DIR
# api       = fetch runs from a configured upstream API
# demo      = bundled sample data (clearly marked)
RAG_BENCHMARK_DATA_MODE=files
RAG_BENCHMARK_RESULTS_DIR=/app/benchmark-results
RAG_BENCHMARK_RESULTS_FILES=MSFT_RAG_BENCHMARK.json,MSFT_RAG_BASELINE.json
RAG_BENCHMARK_RESULTS_LATENCY_UNITS=seconds,ms
ENABLE_DEMO_MODE=true

# --- Upstream benchmark API (only when RAG_BENCHMARK_DATA_MODE=api) ---
RAG_BENCHMARK_API_URL=
RAG_BENCHMARK_API_PATH=/benchmark-runs
RAG_BENCHMARK_API_AUTH_MODE=none
RAG_BENCHMARK_API_TOKEN=
RAG_BENCHMARK_API_TIMEOUT_MS=10000
RAG_BENCHMARK_API_MAX_RESPONSE_BYTES=5242880
RAG_BENCHMARK_CACHE_TTL_SECONDS=30
RAG_BENCHMARK_ALLOW_STALE_SECONDS=3600

# --- Upload / ingestion limits ---
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_BATCH=5
UPLOAD_MAX_TEXT=2000000

# --- State / storage locations (server-side, persistent volumes) ---
ADMIN_DATA_DIR=/var/lib/rag-console

# --- Logging ---
LOG_LEVEL=info